// rainFx — GENERATED by tools/gen_rain_fx.py (edit that, not this).
// Rain on the ground, read from the frame's depth: wet surfaces, puddles that
// mirror the sky, ripples in them and the spray of drops landing near the
// camera. Driven by scripts/rain_fx.lua. Medium: two grids, spray looked for at one height.
shader rainFx {
  stage post
  // the anchor: a point on the ground near the camera, in WORLD space (fixed in
  // the planet's frame by the script, which re-sends it every frame)
  uniform anchor: vec3 = vec3(0.0, 0.0, 0.0)
  // the tangent plane at the anchor: east, north, up (world, unit)
  uniform axisE: vec3 = vec3(1.0, 0.0, 0.0)
  uniform axisN: vec3 = vec3(0.0, 0.0, 1.0)
  uniform axisU: vec3 = vec3(0.0, 1.0, 0.0)
  // the planet's own axes (world, unit) and the anchor in them (m): the
  // puddles are a noise in the planet's frame, so they stay put
  uniform planetX: vec3 = vec3(1.0, 0.0, 0.0)
  uniform planetY: vec3 = vec3(0.0, 1.0, 0.0)
  uniform planetZ: vec3 = vec3(0.0, 0.0, 1.0)
  uniform anchorLocal: vec3 = vec3(0.0, 0.0, 0.0)
  // x: drops landing (0..1), y: how wet (0..1), z: puddles (0..1), w: how far
  // out the splashes are drawn (m)
  uniform rain: vec4 = vec4(0.0, 0.0, 0.0, 20.0)
  // what a wet surface mirrors: the sky's colour at the horizon, in real light
  uniform sky: vec3 = vec3(0.5, 0.55, 0.6)
  // the light a drop is seen by
  uniform drop: vec3 = vec3(0.6, 0.65, 0.7)
  // the haze: x start, y end of the flat ramp (m), z the marched density (1/m)
  uniform fog: vec3 = vec3(100000.0, 200000.0, 0.0)
  // drop grid 0: x cell size (m), y period (s), zw offset (m) — scripts/rain_fx.lua GRIDS
  uniform grid0: vec4 = vec4(0.45, 0.95, 0.0, 0.0)
  // drop grid 1: x cell size (m), y period (s), zw offset (m) — scripts/rain_fx.lua GRIDS
  uniform grid1: vec4 = vec4(0.6, 1.27, 0.37, 0.71)

  let c0 = sceneColor().rgb
  let d = sceneDepth()
  let ray = sceneRay()
  let fwd = sceneRay(vec2(0.5, 0.5))
  let solid = 1.0 - step(50000.0, d)
  let cosf = max(dot(ray, fwd), 0.05)
  let dist = min(d / cosf, 60000.0)
  let q = cameraPosition() + ray * dist - anchor
  // the surface's normal in the world, from this pixel's point and its right
  // and lower neighbours' (cheaper than sceneNormal plus the camera's axes,
  // and the neighbours' spacing is the pixel's footprint on the surface). A
  // pixel on a silhouette (a neighbour much further or nearer) is left dry.
  let tx = screenTexel()
  let dX = sceneDepth(uv + vec2(tx.x, 0.0))
  let dY = sceneDepth(uv + vec2(0.0, tx.y))
  let rX = sceneRay(uv + vec2(tx.x, 0.0))
  let rY = sceneRay(uv + vec2(0.0, tx.y))
  let eX = rX * (dX / max(dot(rX, fwd), 0.05)) - ray * dist
  let eY = rY * (dY / max(dot(rY, fwd), 0.05)) - ray * dist
  let nw0 = normalize(cross(eX, eY))
  let nw = nw0 * sign(dot(nw0, ray) * -1.0 + 0.000001)
  let edge = step(abs(dX - d) + abs(dY - d), d * 0.08 + 0.05)
  let up = dot(nw, axisU) * edge
  let foot = max(length(eX), length(eY))
  // how much of the surface's own light the haze leaves (the pass runs on the
  // finished frame, so the far ground's wet look fades into the haze)
  let fogT = (1.0 - saturate((dist - fog.x) / max(fog.y - fog.x, 1.0))) * exp(-fog.z * dist) * solid
  // wet: up-facing surfaces most, walls a little, overhangs not at all
  let face = saturate(0.35 + 0.65 * up)
  let flatUp = smoothstep(0.8, 0.95, up)
  let wet = rain.y * face * fogT
  // the sky's sheen at grazing angles (Schlick)
  let cosv = saturate(dot(ray * -1.0, nw))
  // (capped: at a grazing angle a whole puddle went the sky's colour and read as snow)
  let fres = min(0.02 + 0.98 * pow(1.0 - cosv, 5.0), 0.45)

  // puddles: a noise in the planet's frame under a level that rises with the rain
  let L = vec3(dot(q, planetX), dot(q, planetY), dot(q, planetZ)) + anchorLocal
  let pn = valueNoise(L * 0.42) * 0.68 + valueNoise(vec2(L.x + L.y * 0.71, L.z - L.y * 0.63) * 1.9) * 0.32
  let lvl = 0.73 - 0.11 * rain.z
  let pud = smoothstep(lvl, lvl + 0.06, pn) * smoothstep(0.93, 0.985, up) * saturate(rain.z * 3.0) * fogT

  let dn = max(dot(ray, axisU) * -1.0, 0.12)
  let near = (1.0 - smoothstep(rain.w * 0.4, rain.w, dist)) * flatUp * solid
  let gq = vec2(dot(q, axisE), dot(q, axisN))
  // ── grid 0: cells grid0.x m across, a drop every grid0.y s at most ──
  let g0 = gq + vec2(grid0.z, grid0.w)
  let k0 = floor(g0 / grid0.x)
  let f0 = g0 / grid0.x - k0
  let ha0a = fract(vec3(k0.x, k0.y, k0.x) * 0.1031)
  let ha0b = ha0a + dot(ha0a, vec3(ha0a.y, ha0a.z, ha0a.x) + 33.33)
  let ha0 = fract((ha0b.x + ha0b.y) * ha0b.z)
  let hb0a = fract(vec3((k0 + vec2(19.19, 7.31)).x, (k0 + vec2(19.19, 7.31)).y, (k0 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb0b = hb0a + dot(hb0a, vec3(hb0a.y, hb0a.z, hb0a.x) + 33.33)
  let hb0 = fract((hb0b.x + hb0b.y) * hb0b.z)
  let ph0 = time / grid0.y + ha0
  let cy0 = floor(ph0)
  let t0 = ph0 - cy0
  let hc0a = fract(vec3((k0 + vec2(cy0 * 3.17, cy0 * 1.73)).x, (k0 + vec2(cy0 * 3.17, cy0 * 1.73)).y, (k0 + vec2(cy0 * 3.17, cy0 * 1.73)).x) * 0.1031)
  let hc0b = hc0a + dot(hc0a, vec3(hc0a.y, hc0a.z, hc0a.x) + 33.33)
  let hc0 = fract((hc0b.x + hc0b.y) * hc0b.z)
  let on0 = step(hc0, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r0 = length(f0 - vec2(0.25 + 0.5 * ha0, 0.25 + 0.5 * hb0)) * grid0.x
  let rr0 = (grid0.x * 0.25) * sqrt(t0)
  let rw0 = max(0.008 + 0.01 * t0, foot)
  let ring0 = exp(((r0 - rr0) / rw0) * ((r0 - rr0) / rw0) * -1.0) * (1.0 - t0) * (1.0 - t0) * on0 * min(0.012 / rw0, 1.0)
  let hit0 = exp(r0 * r0 / max(0.0001, foot * foot * 0.5 + 0.00006) * -1.0) * (1.0 - smoothstep(0.0, 0.03, t0)) * on0
  let qh00 = q - ray * min(0.040 / dn, 0.8)
  let g00 = vec2(dot(qh00, axisE), dot(qh00, axisN)) + vec2(grid0.z, grid0.w)
  let k00 = floor(g00 / grid0.x)
  let f00 = g00 / grid0.x - k00
  let ha00a = fract(vec3(k00.x, k00.y, k00.x) * 0.1031)
  let ha00b = ha00a + dot(ha00a, vec3(ha00a.y, ha00a.z, ha00a.x) + 33.33)
  let ha00 = fract((ha00b.x + ha00b.y) * ha00b.z)
  let hb00a = fract(vec3((k00 + vec2(19.19, 7.31)).x, (k00 + vec2(19.19, 7.31)).y, (k00 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb00b = hb00a + dot(hb00a, vec3(hb00a.y, hb00a.z, hb00a.x) + 33.33)
  let hb00 = fract((hb00b.x + hb00b.y) * hb00b.z)
  let ph00 = time / grid0.y + ha00
  let cy00 = floor(ph00)
  let t00 = ph00 - cy00
  let hc00a = fract(vec3((k00 + vec2(cy00 * 3.17, cy00 * 1.73)).x, (k00 + vec2(cy00 * 3.17, cy00 * 1.73)).y, (k00 + vec2(cy00 * 3.17, cy00 * 1.73)).x) * 0.1031)
  let hc00b = hc00a + dot(hc00a, vec3(hc00a.y, hc00a.z, hc00a.x) + 33.33)
  let hc00 = fract((hc00b.x + hc00b.y) * hc00b.z)
  let on00 = step(hc00, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r00 = length(f00 - vec2(0.25 + 0.5 * ha00, 0.25 + 0.5 * hb00)) * grid0.x
  let ct00 = saturate(t00 / 0.24)
  let ch00 = (0.035 + 0.075 * hb00) * sin(ct00 * 3.1416)
  let cr00 = (0.006 + (0.03 + 0.025 * hb00) * ct00) * (1.0 + 0.040 * 7.0)
  let cw00 = max(0.008 + 0.01 * ct00, foot * 0.6)
  let cd00 = g00 - (k00 + vec2(0.25 + 0.5 * ha00, 0.25 + 0.5 * hb00)) * grid0.x
  let sp00 = pow(saturate(0.5 + 0.5 * sin(atan2(cd00.y, cd00.x) * 5.0 + ha00 * 40.0 + 0.040 * 30.0)), 2.0)
  let crown00 = exp(((r00 - cr00) / cw00) * ((r00 - cr00) / cw00) * -1.0) * mix(1.0, sp00, 0.55 * min(0.012 / cw00, 1.0)) * smoothstep(ch00, ch00 * 0.5, 0.040) * step(t00, 0.24) * on00 * min(0.012 / cw00, 1.0) * (0.45 + 0.55 * hb00)
  // ── grid 1: cells grid1.x m across, a drop every grid1.y s at most ──
  let g1 = gq + vec2(grid1.z, grid1.w)
  let k1 = floor(g1 / grid1.x)
  let f1 = g1 / grid1.x - k1
  let ha1a = fract(vec3(k1.x, k1.y, k1.x) * 0.1031)
  let ha1b = ha1a + dot(ha1a, vec3(ha1a.y, ha1a.z, ha1a.x) + 33.33)
  let ha1 = fract((ha1b.x + ha1b.y) * ha1b.z)
  let hb1a = fract(vec3((k1 + vec2(19.19, 7.31)).x, (k1 + vec2(19.19, 7.31)).y, (k1 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb1b = hb1a + dot(hb1a, vec3(hb1a.y, hb1a.z, hb1a.x) + 33.33)
  let hb1 = fract((hb1b.x + hb1b.y) * hb1b.z)
  let ph1 = time / grid1.y + ha1
  let cy1 = floor(ph1)
  let t1 = ph1 - cy1
  let hc1a = fract(vec3((k1 + vec2(cy1 * 3.17, cy1 * 1.73)).x, (k1 + vec2(cy1 * 3.17, cy1 * 1.73)).y, (k1 + vec2(cy1 * 3.17, cy1 * 1.73)).x) * 0.1031)
  let hc1b = hc1a + dot(hc1a, vec3(hc1a.y, hc1a.z, hc1a.x) + 33.33)
  let hc1 = fract((hc1b.x + hc1b.y) * hc1b.z)
  let on1 = step(hc1, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r1 = length(f1 - vec2(0.25 + 0.5 * ha1, 0.25 + 0.5 * hb1)) * grid1.x
  let rr1 = (grid1.x * 0.25) * sqrt(t1)
  let rw1 = max(0.008 + 0.01 * t1, foot)
  let ring1 = exp(((r1 - rr1) / rw1) * ((r1 - rr1) / rw1) * -1.0) * (1.0 - t1) * (1.0 - t1) * on1 * min(0.012 / rw1, 1.0)
  let hit1 = exp(r1 * r1 / max(0.0001, foot * foot * 0.5 + 0.00006) * -1.0) * (1.0 - smoothstep(0.0, 0.03, t1)) * on1
  let qh10 = q - ray * min(0.040 / dn, 0.8)
  let g10 = vec2(dot(qh10, axisE), dot(qh10, axisN)) + vec2(grid1.z, grid1.w)
  let k10 = floor(g10 / grid1.x)
  let f10 = g10 / grid1.x - k10
  let ha10a = fract(vec3(k10.x, k10.y, k10.x) * 0.1031)
  let ha10b = ha10a + dot(ha10a, vec3(ha10a.y, ha10a.z, ha10a.x) + 33.33)
  let ha10 = fract((ha10b.x + ha10b.y) * ha10b.z)
  let hb10a = fract(vec3((k10 + vec2(19.19, 7.31)).x, (k10 + vec2(19.19, 7.31)).y, (k10 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb10b = hb10a + dot(hb10a, vec3(hb10a.y, hb10a.z, hb10a.x) + 33.33)
  let hb10 = fract((hb10b.x + hb10b.y) * hb10b.z)
  let ph10 = time / grid1.y + ha10
  let cy10 = floor(ph10)
  let t10 = ph10 - cy10
  let hc10a = fract(vec3((k10 + vec2(cy10 * 3.17, cy10 * 1.73)).x, (k10 + vec2(cy10 * 3.17, cy10 * 1.73)).y, (k10 + vec2(cy10 * 3.17, cy10 * 1.73)).x) * 0.1031)
  let hc10b = hc10a + dot(hc10a, vec3(hc10a.y, hc10a.z, hc10a.x) + 33.33)
  let hc10 = fract((hc10b.x + hc10b.y) * hc10b.z)
  let on10 = step(hc10, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r10 = length(f10 - vec2(0.25 + 0.5 * ha10, 0.25 + 0.5 * hb10)) * grid1.x
  let ct10 = saturate(t10 / 0.24)
  let ch10 = (0.035 + 0.075 * hb10) * sin(ct10 * 3.1416)
  let cr10 = (0.006 + (0.03 + 0.025 * hb10) * ct10) * (1.0 + 0.040 * 7.0)
  let cw10 = max(0.008 + 0.01 * ct10, foot * 0.6)
  let cd10 = g10 - (k10 + vec2(0.25 + 0.5 * ha10, 0.25 + 0.5 * hb10)) * grid1.x
  let sp10 = pow(saturate(0.5 + 0.5 * sin(atan2(cd10.y, cd10.x) * 5.0 + ha10 * 40.0 + 0.040 * 30.0)), 2.0)
  let crown10 = exp(((r10 - cr10) / cw10) * ((r10 - cr10) / cw10) * -1.0) * mix(1.0, sp10, 0.55 * min(0.012 / cw10, 1.0)) * smoothstep(ch10, ch10 * 0.5, 0.040) * step(t10, 0.24) * on10 * min(0.012 / cw10, 1.0) * (0.45 + 0.55 * hb10)
  let rings = saturate(ring0 + ring1)
  let spray = saturate(hit0 + crown00 + hit1 + crown10)

  // ── the composite ──
  // wet darkens (the film of water stops the surface scattering its light) and
  // mirrors the sky at grazing angles; a puddle is darker and a clearer
  // mirror, broken up where the rings run across it
  let dark = 1.0 - wet * 0.25 - pud * 0.22
  let sheen = sky * fres * (wet * flatUp * 0.3 + wet * 0.1 + pud * (0.85 + rings * 1.6))
  let spr = drop * (spray * 0.75 + rings * pud * 0.2) * near * fogT
  output color = vec4(c0 * dark + sheen + spr, 1.0)
}
