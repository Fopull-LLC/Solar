// hullPanels — battle damage on a textured, normal-mapped part. The surface is
// the part's own Material (tools/gen_part_meshes.py binds each mesh material
// to a texture set: albedo, normal, ORM) lit by the engine's Physical model
// through `litPbr` (v0.117, card 0408), so a pristine part draws exactly as the
// same material with no shader. On top of it, as `damage` rises: sooty scorch
// blotches, bright bare-metal gouges and beaten-in dents. Every layer is keyed
// to `objectPos` (object-local, world-scaled), so the scars stick to the hull
// instead of swimming with the camera.
//
// The vessel controller drives `damage` per part off its HP
// (node:setShaderParam fans out to every part material wearing this shader).
// `tint` is the material's colour (the shader replaces the built-in look, so
// the colour the material carries is handed in here).
//
// HEAT (scripts/vehicle_fx.lua): `heat` 0 cold … 1 bright orange-red … 1.4
// yellow-white, a blackbody-like glow added on top of the lit surface, so a
// nozzle after a long burn or a hull through reentry glows in the dark and
// shows against daylight once it is properly hot. `flow` is the airflow's
// direction in the world (the craft's velocity, unit) for reentry: faces
// turned into it glow, the lee side stays dark. (0,0,0) = glow all over (an
// engine's own heat). The glow is broken up by the same soot noise as the
// scorch, so it reads as uneven metal, not a lamp.
shader hullPanels {
  stage fragment
  uniform tint:   color = #FFFFFF
  // Battle damage, 0 pristine … 1 wrecked.
  uniform damage: float = 0.0 range(0, 1)
  // Heat glow, 0 cold … 1 orange-red … 1.4 yellow-white.
  uniform heat:   float = 0.0 range(0, 1.5)
  // Airflow direction (world, unit) for a windward-only glow; zero = all over.
  uniform flow:   vec3 = vec3(0, 0, 0)

  let albedo = baseTexture().rgb * tint.rgb * instanceColor.rgb

  // ── battle damage ──────────────────────────────────────────────────────────
  let dmg     = saturate(damage)
  // Front-loaded: parts often break fast, so even a little damage must read
  // as obvious scars, not a subtle tint. sqrt ramps hard off zero.
  let vis     = sqrt(dmg)
  // Scorch: sooty blotches over a wide range, spreading as it takes a beating.
  let soot    = smoothstep(0.25, 0.75, fbm(objectPos * 1.6, octaves: 4.0) * 0.5 + 0.5)
  let scorch  = saturate(soot * vis * 1.4)
  // Gouges: bright bare-metal scratches along worley cell edges, widening
  // with damage so a wrecked hull is criss-crossed with scuffs.
  let gouge   = (1.0 - smoothstep(0.0, 0.06 + 0.18 * dmg, worley(objectPos * 3.2))) * vis
  // Dents: mid-frequency shading break-up, so the surface looks beaten.
  let n55     = fbm(objectPos * 5.5, octaves: 3.0) * 0.5 + 0.5
  let dents   = mix(1.0, 0.45 + 0.55 * n55, vis)
  let burnt   = mix(albedo, vec3(0.03, 0.025, 0.022), scorch)
  let scarred = mix(burnt, vec3(0.66, 0.64, 0.6), saturate(gouge)) * dents

  // ── heat ───────────────────────────────────────────────────────────────────
  let h       = clamp(heat, 0.0, 1.5)
  // windward mask: 1 everywhere with no flow, else the faces turned into it
  let fl      = length(flow)
  let lead    = mix(1.0, smoothstep(-0.15, 0.7, dot(normal, flow / max(fl, 0.001))), saturate(fl))
  // blackbody-ish: dull cherry → orange-red → yellow-white
  let bb      = mix(vec3(0.55, 0.035, 0.0), vec3(1.0, 0.3, 0.04), smoothstep(0.15, 0.85, h))
  let bbw     = mix(bb, vec3(1.0, 0.72, 0.42), smoothstep(0.95, 1.4, h))
  let mottle  = 0.42 + 0.9 * n55
  let glowk   = h * h * (0.35 + 3.2 * h * h) * lead * mottle
  // hot metal darkens and loses its sheen under its own glow (oxide)
  let cooked  = scarred * (1.0 - 0.45 * saturate(h * 1.6) * lead)

  output color = vec4(litPbr(cooked) + bbw * glowk, 1.0)
}
