  let rr2 = (grid2.x * 0.25) * sqrt(t2)
  let rw2 = max(0.008 + 0.01 * t2, foot)
  let ring2 = exp(((r2 - rr2) / rw2) * ((r2 - rr2) / rw2) * -1.0) * (1.0 - t2) * (1.0 - t2) * on2 * min(0.012 / rw2, 1.0)
  let hit2 = exp(r2 * r2 / max(0.0001, foot * foot * 0.5 + 0.00006) * -1.0) * (1.0 - smoothstep(0.0, 0.03, t2)) * on2
  let qh20 = q - ray * min(0.025 / dn, 0.8)
  let g20 = vec2(dot(qh20, axisE), dot(qh20, axisN)) + vec2(grid2.z, grid2.w)
  let k20 = floor(g20 / grid2.x)
  let f20 = g20 / grid2.x - k20
  let ha20a = fract(vec3(k20.x, k20.y, k20.x) * 0.1031)
  let ha20b = ha20a + dot(ha20a, vec3(ha20a.y, ha20a.z, ha20a.x) + 33.33)
  let ha20 = fract((ha20b.x + ha20b.y) * ha20b.z)
  let hb20a = fract(vec3((k20 + vec2(19.19, 7.31)).x, (k20 + vec2(19.19, 7.31)).y, (k20 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb20b = hb20a + dot(hb20a, vec3(hb20a.y, hb20a.z, hb20a.x) + 33.33)
  let hb20 = fract((hb20b.x + hb20b.y) * hb20b.z)
  let ph20 = time / grid2.y + ha20
  let cy20 = floor(ph20)
  let t20 = ph20 - cy20
  let hc20a = fract(vec3((k20 + vec2(cy20 * 3.17, cy20 * 1.73)).x, (k20 + vec2(cy20 * 3.17, cy20 * 1.73)).y, (k20 + vec2(cy20 * 3.17, cy20 * 1.73)).x) * 0.1031)
  let hc20b = hc20a + dot(hc20a, vec3(hc20a.y, hc20a.z, hc20a.x) + 33.33)
  let hc20 = fract((hc20b.x + hc20b.y) * hc20b.z)
  let on20 = step(hc20, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r20 = length(f20 - vec2(0.25 + 0.5 * ha20, 0.25 + 0.5 * hb20)) * grid2.x
  let ct20 = saturate(t20 / 0.24)
  let ch20 = (0.035 + 0.075 * hb20) * sin(ct20 * 3.1416)
  let cr20 = (0.006 + (0.03 + 0.025 * hb20) * ct20) * (1.0 + 0.025 * 7.0)
  let cw20 = max(0.008 + 0.01 * ct20, foot * 0.6)
  let cd20 = g20 - (k20 + vec2(0.25 + 0.5 * ha20, 0.25 + 0.5 * hb20)) * grid2.x
  let sp20 = pow(saturate(0.5 + 0.5 * sin(atan2(cd20.y, cd20.x) * 5.0 + ha20 * 40.0 + 0.025 * 30.0)), 2.0)
  let crown20 = exp(((r20 - cr20) / cw20) * ((r20 - cr20) / cw20) * -1.0) * mix(1.0, sp20, 0.55 * min(0.012 / cw20, 1.0)) * smoothstep(ch20, ch20 * 0.5, 0.025) * step(t20, 0.24) * on20 * min(0.012 / cw20, 1.0) * (0.45 + 0.55 * hb20)
  let qh21 = q - ray * min(0.070 / dn, 0.8)
  let g21 = vec2(dot(qh21, axisE), dot(qh21, axisN)) + vec2(grid2.z, grid2.w)
  let k21 = floor(g21 / grid2.x)
  let f21 = g21 / grid2.x - k21
  let ha21a = fract(vec3(k21.x, k21.y, k21.x) * 0.1031)
  let ha21b = ha21a + dot(ha21a, vec3(ha21a.y, ha21a.z, ha21a.x) + 33.33)
  let ha21 = fract((ha21b.x + ha21b.y) * ha21b.z)
  let hb21a = fract(vec3((k21 + vec2(19.19, 7.31)).x, (k21 + vec2(19.19, 7.31)).y, (k21 + vec2(19.19, 7.31)).x) * 0.1031)
  let hb21b = hb21a + dot(hb21a, vec3(hb21a.y, hb21a.z, hb21a.x) + 33.33)
  let hb21 = fract((hb21b.x + hb21b.y) * hb21b.z)
  let ph21 = time / grid2.y + ha21
  let cy21 = floor(ph21)
  let t21 = ph21 - cy21
  let hc21a = fract(vec3((k21 + vec2(cy21 * 3.17, cy21 * 1.73)).x, (k21 + vec2(cy21 * 3.17, cy21 * 1.73)).y, (k21 + vec2(cy21 * 3.17, cy21 * 1.73)).x) * 0.1031)
  let hc21b = hc21a + dot(hc21a, vec3(hc21a.y, hc21a.z, hc21a.x) + 33.33)
  let hc21 = fract((hc21b.x + hc21b.y) * hc21b.z)
  let on21 = step(hc21, rain.x)
  // the drop sits in the middle half of its cell, so its ring never leaves it
  let r21 = length(f21 - vec2(0.25 + 0.5 * ha21, 0.25 + 0.5 * hb21)) * grid2.x
  let ct21 = saturate(t21 / 0.24)
  let ch21 = (0.035 + 0.075 * hb21) * sin(ct21 * 3.1416)
  let cr21 = (0.006 + (0.03 + 0.025 * hb21) * ct21) * (1.0 + 0.070 * 7.0)
  let cw21 = max(0.008 + 0.01 * ct21, foot * 0.6)
  let cd21 = g21 - (k21 + vec2(0.25 + 0.5 * ha21, 0.25 + 0.5 * hb21)) * grid2.x
  let sp21 = pow(saturate(0.5 + 0.5 * sin(atan2(cd21.y, cd21.x) * 5.0 + ha21 * 40.0 + 0.070 * 30.0)), 2.0)
  let crown21 = exp(((r21 - cr21) / cw21) * ((r21 - cr21) / cw21) * -1.0) * mix(1.0, sp21, 0.55 * min(0.012 / cw21, 1.0)) * smoothstep(ch21, ch21 * 0.5, 0.070) * step(t21, 0.24) * on21 * min(0.012 / cw21, 1.0) * (0.45 + 0.55 * hb21)
  let rings = saturate(ring0 + ring1 + ring2)
  let spray = saturate(hit0 + crown00 + crown01 + hit1 + crown10 + crown11 + hit2 + crown20 + crown21)

  // ── the composite ──
  // wet darkens (the film of water stops the surface scattering its light) and
  // mirrors the sky at grazing angles; a puddle is darker and a clearer
  // mirror, broken up where the rings run across it
  let dark = 1.0 - wet * 0.25 - pud * 0.22
  let sheen = sky * fres * (wet * flatUp * 0.3 + wet * 0.1 + pud * (0.85 + rings * 1.6))
  let spr = drop * (spray * 0.75 + rings * pud * 0.2) * near * fogT
  output color = vec4(c0 * dark + sheen + spr, 1.0)
}
