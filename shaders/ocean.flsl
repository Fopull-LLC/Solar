// OCEAN — the sea surface of a generated world.
//
// Drawn on a unit icosphere (models/water/ocean_sphere.glb) scaled to the sea
// radius, so `objectPos` is metres on the sea and `normalize(objectPos)` is the
// exact local up. Bodies do not rotate, so object axes are world axes and the
// normal built here is lit against world directions directly.
//
//   waves    a long swell and a short chop drifting different ways; their
//            gradient (three samples, along the surface) bends the normal.
//            They are in the light, normals only: `output offset` could
//            move the mesh, but this sphere's vertices are ~28 m apart at
//            scale 3 — far too coarse to carry a wave.
//   behind   the sea is SEE-THROUGH (engine 0.117 rc3, card 0454): the
//            scene behind the surface (sceneColor), looked at where the
//            wave-tilted ray meets it (refraction), and the length of water
//            the view ray crosses to get there (sceneDepth − the surface's
//            own distance). A look that bends onto something in FRONT of the
//            water keeps the straight look instead.
//   sky      the reflected ray sees a horizon-to-zenith gradient of the
//            world's own air colour, weighted by Fresnel, plus a sun glint.
//            The two ends are the sky as the engine DRAWS it (skyColor the
//            pale horizon, zenithColor the deep overhead, pushed by
//            scripts/ocean.lua and climate.lua from atmosphere.lua's air):
//            a mirror of the rolled pastel was paler than the real sky, and
//            at a grazing look the water became a flat sheet of it.
//   body     Beer–Lambert, per channel: the water's own absorption per metre
//            (`absorb`, from the chemistry, climate.waterAbsorb: clear water
//            eats red first, tea-brown water blue first) over the view ray's
//            path through the water. What comes through is the REAL bed as
//            the engine lit it; what is lost is replaced by the column's own
//            scattered light (deepColor, a little of shallowColor where the
//            water is thin). Clear shallows show their pebbles tinted
//            turquoise, then blue, then navy as they deepen, each world's
//            water in its own order. `bodyLight` darkens dark water (tannin,
//            iron, methane), whose lit tint read as sand.
//   wind     the weather's wind at the eye (scripts, weather.current): waves
//            run downwind and grow with it, and past a fresh breeze their
//            crests break into whitecaps.
//   surf     the vertical depth (the water crossed × the look's steepness) is how
//            deep the water is over the bottom here. Where it shallows, bands of foam
//            roll in toward the waterline (their phase advances as depth
//            falls) and a swash line runs up the beach and draws back.
//
// Lighting is its own (sun term + sky) rather than litSurface: the engine's
// lit path marches the terrain shadow for every fragment, and a sea covers a
// lot of fragments. The sun is the engine's key light (lightDir, and the hue of
// lightColor); skyColor is pushed by scripts/ocean.lua from the world's air.
shader ocean {
  stage fragment
  blend alpha
  uniform deepColor: color = #06263F
  uniform shallowColor: color = #1B8E98
  uniform skyColor: color = #9CC4E4
  uniform zenithColor: color = #4F7FB8
  uniform bodyLight: float = 1 range(0.1, 2)
  uniform waveScale: float = 0.34 range(0.02, 2)
  uniform waveSpeed: float = 0.35 range(0, 3)
  uniform bump: float = 0.32 range(0, 2)
  uniform surfDepth: float = 0.5 range(0.1, 5)
  uniform surfSpacing: float = 0.16 range(0.05, 2)
  uniform surfSpeed: float = 0.3 range(0, 2)
  uniform debugView: float = 0 range(0, 1)
  // 0 at the shore, 1 from high orbit (scripts/ocean.lua, by the eye's height):
  // metre-scale waves are sub-pixel from orbit and only shimmer there, so they
  // smooth out and the sun's glint spreads into the broad sunglint a whole
  // ocean shows from space.
  uniform farFade: float = 0 range(0, 1)
  // Absorption per metre, per channel (scripts: climate.waterAbsorb).
  uniform absorb: vec3 = vec3(0.45, 0.09, 0.06)
  // The wind: the direction it blows TOWARD (planet frame = world axes) and
  // its speed, m/s.
  uniform windDir: vec3 = vec3(0.6, 0, 0.8)
  uniform wind: float = 4 range(0, 40)
  // How far the waves bend the look at the bed, per metre of water (to 3 m).
  uniform refractK: float = 0.2 range(0, 2)

  let up = normalize(objectPos)
  let sunDir = lightDir
  let sunColor = lightColor / max(max(lightColor.x, max(lightColor.y, lightColor.z)), 0.001)
  // Waves run downwind, faster and taller as it freshens; the chop crosses
  // them at an angle.
  let wdir = normalize(windDir - up * dot(windDir, up) + cross(up, vec3(0.37, 0.83, 0.42)) * 0.001)
  let windK = saturate(wind / 12)
  let tw = time * waveSpeed * (0.7 + 0.9 * windK)
  let drift = wdir * tw * 1.1
  let chopDrift = (cross(up, wdir) * 0.6 - wdir) * tw * 1.7
  let q = objectPos * waveScale

  // Two tangents on the sea sphere; never parallel to `up` in practice.
  let t1 = normalize(cross(up, vec3(0.37, 0.83, 0.42)))
  let t2 = cross(up, t1)
  let e = 0.35
  let h0 = fbm(q + drift, octaves: 2) + noise(q * 3.3 + chopDrift) * 0.3
  let h1 = fbm(q + t1 * e + drift, octaves: 2) + noise((q + t1 * e) * 3.3 + chopDrift) * 0.3
  let h2 = fbm(q + t2 * e + drift, octaves: 2) + noise((q + t2 * e) * 3.3 + chopDrift) * 0.3
  let slope = (t1 * (h1 - h0) + t2 * (h2 - h0)) / e
  let nw = normalize(up - slope * bump * (0.85 + 0.6 * windK) * (1 - farFade * 0.92))

  // Seen from below (a swimmer looking up) the mesh's back face is what draws.
  let side = mix(-1, 1, step(0, dot(up, viewDir)))
  let n = nw * side
  let ndv = saturate(dot(n, viewDir))
  let fres = 0.02 + 0.98 * pow(1 - ndv, 5)

  // Day on this side of the world, or night.
  let sunUp = dot(sunDir, up)
  let day = saturate(sunUp * 3 + 0.25)

  // Through the water to the scene behind it. worldPos is measured from the
  // camera, so its length is the surface's own distance; sceneDepth is the
  // solid scene's (water and glass are not in it).
  let dist = length(worldPos)
  let suv0 = screenUv(worldPos)
  let thick0 = max(sceneDepth(suv0) - dist, 0)
  // Refraction: the bed where the wave-tilted ray meets it — the point pushed
  // along the normal's tilt, further through more water (to 3 m).
  let tilt = nw - up * dot(nw, up)
  let suv1 = screenUv(worldPos - tilt * refractK * min(thick0, 3) * (1 - farFade))
  let fore = step(sceneDepth(suv1), dist + 0.05)
  let suv = mix(suv1, suv0, fore)
  // From under the surface the water is between the eye and the surface
  // (the air beyond absorbs nothing): the light crosses `dist` of it.
  let thick = mix(dist, max(sceneDepth(suv) - dist, 0), step(0, side))
  let behind = sceneColor(suv).rgb
  let trans = exp(-absorb * min(thick, 400))
  let deep = 1 - (trans.x + trans.y + trans.z) / 3
  // The column's own light where the bed is lost: navy in deep water, a
  // touch of the shallow tint while it is thin.
  let column = mix(shallowColor.rgb * 0.55, deepColor.rgb, saturate(deep * 1.4)) * bodyLight

  // Surf, keyed to how shallow the water is here.
  // How deep the water is here: the view ray's path through it (read from
  // the drawn depth, so it follows the TRUE terrain outline) turned vertical
  // by the angle of the look, held at grazing angles.
  let sd = min(thick0 * max(abs(dot(viewDir, up)), 0.15), 1000) + (1 - step(0, side)) * 1000
  let shore = 1 - smoothstep(0, surfDepth, sd)
  let jitter = noise(objectPos * 0.21 + drift * 0.2) * 0.35
  let phase = sd / surfSpacing + time * surfSpeed + jitter
  let crest = pow(saturate(sin(phase * 6.2832) * 0.5 + 0.5), 10)
  let bubbles = smoothstep(-0.05, 0.6, noise(objectPos * 3.1 + drift * 2.5))
  let swashReach = 0.05 + 0.15 * (sin(time * 1.1 + jitter * 6) * 0.5 + 0.5)
  let swash = 1 - smoothstep(0, swashReach, sd)
  // Whitecaps: past a fresh breeze (~6 m/s) the tallest crests break.
  let capAt = 1 - smoothstep(5, 16, wind) * 0.55
  let caps = smoothstep(capAt, capAt + 0.12, h0 * 0.5 + 0.5) * smoothstep(5, 9, wind) * (1 - farFade)
  let foam = saturate((crest * shore * shore * 0.9 + swash) * bubbles + caps * bubbles * 0.8)

  // Light on the column and the foam: sun (wrapped a little, water
  // scatters) + a sky-tinted ambient. The bed behind is already lit.
  let diffuse = saturate(dot(nw, sunDir) * 0.8 + 0.2) * day
  let light = sunColor * diffuse + skyColor.rgb * (0.12 + 0.18 * day)
  let water = behind * trans + column * light * (1 - trans)
  let lit = mix(water, vec3(0.93, 0.965, 0.98) * light, foam)

  // The sky as the reflected ray sees it: the bright hazy horizon giving way to
  // a darker zenith. A mirror of a flat sky is a flat sheet whatever the waves
  // do; the gradient is what makes them read.
  let rv = reflect(-viewDir, n)
  let elev = saturate(dot(rv, up))
  let sky = mix(skyColor.rgb, zenithColor.rgb, pow(elev, 0.45)) * (0.06 + 0.94 * day)
  let glintDot = saturate(dot(rv, sunDir))
  let glint = pow(glintDot, mix(420, 90, farFade)) * mix(7, 2.2, farFade) + pow(glintDot, mix(48, 12, farFade)) * mix(0.18, 0.3, farFade)
  let spec = sunColor * glint * day * (1 - foam) * step(0, side)
  let reflected = min(fres, 0.6) * (1 - foam)
  let col = mix(lit, sky, reflected) + spec

  // Feathered where the water meets the ground, so the waterline is a soft
  // wet edge instead of the terrain mesh's polygon outline.
  // (and by the depth behind, so a mesh edge over a dip fades, not cuts).
  // A lake mesh (climate.lua) marks its vertices uv = (fade, 7); the sea's
  // own uvs never reach 7. A lake's outermost ring over open water fades.
  let lakeEdge = mix(1, saturate(uv.x), step(6.5, uv.y))
  let edge = smoothstep(0, 0.1, sd) * lakeEdge
  // The water is drawn whole (what is behind it is already in its colour):
  // only the waterline and a lake mesh's open edge fade.
  let alpha = edge
  let dbg = vec3(shore, saturate(thick / 20), saturate(sd / 3))
  output color = mix(vec4(col, alpha * instanceColor.a), vec4(dbg, 1), debugView)
}
