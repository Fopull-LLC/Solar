// RIVER — the running water of a scale-3 world (scripts/climate.lua builds the
// ribbons along each carved bed and dresses them with this).
//
// The ribbon is a mesh in the planet's own frame, under the body, so
// `objectPos` is metres from the planet's centre and `normalize(objectPos)` is
// the local up — as on the sea (ocean.flsl), whose look this shares: the
// water's own per-channel absorption over its depth (Beer–Lambert), the
// world's sky reflected by Fresnel, a sun glint. What a river adds is FLOW:
//
//   uv       climate.lua writes uv.x = across the stream (−1 one bank, 0 the
//            middle, +1 the other) and uv.y = TRAVEL TIME in seconds from the
//            source (Manning's speed from the bed's slope). A pattern at
//            uv.y − time therefore moves at the water's real local speed.
//   speed    ∂(position)/∂(uv.y), from the screen derivatives (a cotangent
//            frame), IS the velocity: its direction is downstream and its
//            length the speed in m/s. No per-vertex tangent is needed.
//   ripples  a ripple height map (textures/water/river_ripples.png, a
//            tileable sum of waves made by a script: more small ripples
//            than big, sharp crests) read three times a phase for its
//            slope, advected downstream in TWO PHASES half a cycle apart and
//            cross-faded (Vlachos, "Water Flow in Portal 2"): each phase
//            jumps to a fresh offset while its weight is zero, so the
//            pattern keeps renewing instead of riding a conveyor belt.
//            Faster water stretches it into streaks and bends it harder.
//            (Until engine 0.117 rc3 this was noise: a texture slot on a
//            material that also reads the scene overflowed the GPU's 16
//            sampled textures and the pipeline failed — card 0456.)
//   behind   the water is SEE-THROUGH (card 0454): the bed as the engine
//            drew it (sceneColor), seen where the ripple-tilted ray meets it,
//            dimmed per channel by the water the view ray crosses
//            (sceneDepth − the surface's own distance).
//   rapids   above ~2.5 m/s the surface breaks: white water in the fast
//            stretches, foam threads along the banks where the current drags.
//   edges    the ribbon fades toward its sides and where the ground behind
//            comes up through it.
//
// What the bed looks like through the water is the bed: the old look
// (shallowColor standing for a lit bed under an alpha-blended sheet) is
// replaced by the real one, so the water only adds what water adds.
shader river {
  stage fragment
  blend alpha
  uniform deepColor: color = #06263F
  uniform shallowColor: color = #1B8E98
  uniform skyColor: color = #9CC4E4
  uniform zenithColor: color = #4F7FB8
  uniform foamColor: color = #E6EEF2
  uniform absorb: vec3 = vec3(0.45, 0.09, 0.06)
  uniform bodyLight: float = 1 range(0.1, 2)
  uniform flowSpeed: float = 1 range(0, 6)
  uniform bump: float = 0.35 range(0, 2)
  uniform wind: float = 4 range(0, 40)
  uniform debugView: float = 0 range(0, 1)
  // How far the ripples bend the look at the bed, per metre of water.
  uniform refractK: float = 0.5 range(0, 2)
  texture ripples = "textures/water/river_ripples.png"

  let up = normalize(objectPos)
  let sunDir = lightDir
  let sunColor = lightColor / max(max(lightColor.x, max(lightColor.y, lightColor.z)), 0.001)

  // Velocity in the world, from the screen derivatives: ∂p/∂τ.
  let dpx = dpdx(objectPos)
  let dpy = dpdy(objectPos)
  let dux = dpdx(uv)
  let duy = dpdy(uv)
  let det = duy.y * dux.x - dux.y * duy.x
  let vel = (dpy * dux.x - dpx * duy.x) / (det + sign(det) * 0.000001 + 0.0000001)
  let velf = vel - up * dot(vel, up)
  let speed = clamp(length(velf), 0, 8)
  let flow = normalize(velf + cross(up, vec3(0.37, 0.83, 0.42)) * 0.0001)
  let across = cross(up, flow)

  // Two flow phases half a cycle apart, each renewed while it is invisible.
  let period = 2.2
  let c0 = time / period
  let c1 = c0 + 0.5
  let w0 = 1 - abs(fract(c0) * 2 - 1)
  let w1 = 1 - w0
  let j0 = floor(c0)
  let j1 = floor(c1)
  let o0 = vec2(fract(sin(j0 * 12.9898) * 43758.5), fract(sin(j0 * 78.233) * 43758.5))
  let o1 = vec2(fract(sin(j1 * 12.9898 + 4.1) * 43758.5), fract(sin(j1 * 78.233 + 4.1) * 43758.5))
  let along = (uv.y - time * flowSpeed) * 0.2
  // Each phase: the ripple heights and their slope, three reads of the map.
  let ta = vec2(uv.x * 0.22 + o0.x, along + o0.y)
  let tb = vec2(uv.x * 0.22 + o1.x + 0.5, along + o1.y + 0.5)
  let ee = 0.004
  let a0 = sample(ripples, ta).r
  let n0 = vec2(sample(ripples, ta + vec2(ee, 0)).r - a0, sample(ripples, ta + vec2(0, ee)).r - a0) / ee
  let a1 = sample(ripples, tb).r
  let n1 = vec2(sample(ripples, tb + vec2(ee, 0)).r - a1, sample(ripples, tb + vec2(0, ee)).r - a1) / ee
  let nt = (n0 * w0 + n1 * w1) * 0.012
  let rough = bump * (0.7 + 0.25 * speed)
  let n = normalize(up + (across * nt.x + flow * nt.y) * rough)

  let ndv = saturate(dot(n, viewDir))
  let fres = 0.02 + 0.98 * pow(1 - ndv, 5)
  let sunUp = dot(sunDir, up)
  let day = saturate(sunUp * 3 + 0.25)

  // Through the water to the bed: the scene behind, bent by the ripples,
  // dimmed per channel by the water crossed (a stream is never quite clear:
  // some depth of its own even over the bed).
  let dist = length(worldPos)
  let suv0 = screenUv(worldPos)
  let gap = max(sceneDepth(suv0) - dist, 0)
  let tilt = n - up * dot(n, up)
  let suv1 = screenUv(worldPos - tilt * refractK * min(gap, 4))
  let fore = step(sceneDepth(suv1), dist + 0.05)
  let suv = mix(suv1, suv0, fore)
  // From under the surface (a swimmer) the water is between the eye and it.
  let thick = mix(dist, max(sceneDepth(suv) - dist, 0), step(0, dot(up, viewDir)))
  let behind = sceneColor(suv).rgb
  // (+1.5 m: running water carries silt, and a clear film over the bed
  // read as no river at all from a hillside.)
  let trans = exp(-absorb * (min(thick, 60) + 1.5))
  let deep = 1 - (trans.x + trans.y + trans.z) / 3
  let column = mix(shallowColor.rgb * 0.55, deepColor.rgb, saturate(deep * 1.4)) * bodyLight

  // White water: rapids where it runs fast, threads where the banks drag.
  let side = abs(uv.x) + noise(vec3(uv.y * 0.25, 0.5, 2.0)) * 0.12
  let edge = smoothstep(0, 0.1, gap) * (1 - smoothstep(0.55, 0.98, side))
  let streak = smoothstep(0.55, 0.8, a0 * w0 + a1 * w1)
  let rapids = smoothstep(2.2, 3.3, speed)
  let drag = (1 - smoothstep(0.0, 0.3, gap)) * 0.5 + smoothstep(0.45, 0.85, side) * 0.5
  let foam = saturate(drag * drag * streak * 0.4 + rapids * streak * 0.8)

  let diffuse = saturate(dot(n, sunDir) * 0.8 + 0.2) * day
  let light = sunColor * diffuse + skyColor.rgb * (0.12 + 0.18 * day)
  // Silt: a third of what comes back is the stream's own colour whatever is
  // under it, so a river reads as water from a hillside, not as wet rock.
  let water = mix(behind * trans + column * light * (1 - trans), column * light, 0.35)
  let lit = mix(water, foamColor.rgb * light, foam)

  let rv = reflect(-viewDir, n)
  let elev = saturate(dot(rv, up))
  let sky = mix(skyColor.rgb, zenithColor.rgb, pow(elev, 0.45)) * (0.06 + 0.94 * day)
  let gd = saturate(dot(rv, sunDir))
  let spec = sunColor * (pow(gd, 220) * 3 + pow(gd, 30) * 0.12) * day * (1 - foam)
  let reflected = min(fres, 0.6) * (1 - foam)
  let col = mix(lit, sky, reflected) + spec

  // Drawn whole (the bed behind is already in its colour): only the banks fade.
  let alpha = edge
  let dbg = vec3(saturate(speed / 4), fract(uv.y * 0.1), saturate(gap / 6))
  output color = mix(vec4(col, alpha * instanceColor.a), vec4(dbg, 1), debugView)
}
