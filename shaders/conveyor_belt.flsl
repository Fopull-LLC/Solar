// CONVEYOR BELT — the materials intake's feed belt (tools/base_buildings.py
// intake(), scripts/material_intake.lua).
//
// The belt's running surface is one strip of quads whose uv.x runs across it
// (0 one edge, 1 the other) and uv.y is METRES along it from the tail toward
// the head. `phase` is how far the belt has run (the script integrates its
// speed, so the cleats stop when the belt stops and move exactly with what it
// carries): a feature at belt coordinate v sits at uv.y = v + phase.
//
// The look: worn black rubber with raised chevron cleats every `pitch` metres
// (swept back from the centre toward the edges, the way a troughed feed belt's
// cleats are moulded), the bare cover strips along both edges, and grit and
// dust ground into it, all of which travel with the belt. The cleats' slope
// tilts the normal along the run, so they catch the light as relief.
shader conveyor_belt {
  stage fragment
  uniform phase: float = 0.0
  uniform pitch: float = 0.55 range(0.2, 2)

  let v = uv.y - phase
  let across = abs(uv.x - 0.5) * 2.0
  let edge = smoothstep(0.80, 0.86, across)
  // the cleat profile: a short ridge with a gentle back slope
  let c = fract((v + across * 0.32) / pitch)
  let rise = smoothstep(0.0, 0.05, c)
  let fall = 1.0 - smoothstep(0.09, 0.22, c)
  let cleat = rise * fall * (1.0 - edge)
  let slope = ((1.0 - smoothstep(0.0, 0.05, abs(c - 0.025) * 2.0)) - (1.0 - smoothstep(0.0, 0.13, abs(c - 0.155) * 2.0)) * 0.4) * (1.0 - edge)
  // grit and dust, ground in and carried along
  let grit = fbm(vec3(uv.x * 7.0, v * 2.3, 1.7), octaves: 4.0)
  let fleck = fbm(vec3(uv.x * 41.0, v * 13.0, 5.3), octaves: 2.0)
  let rubber = vec3(0.045, 0.043, 0.041) * (0.75 + 0.5 * grit)
  let dust = vec3(0.30, 0.25, 0.19) * smoothstep(0.58, 0.92, grit) * (0.45 + 0.4 * edge)
  let worn = vec3(0.075, 0.071, 0.066) * cleat * (0.8 + 0.4 * fleck)
  let col = rubber + dust * (1.0 - cleat * 0.6) + worn + vec3(0.02, 0.018, 0.015) * smoothstep(0.7, 0.95, fleck)

  // the along-belt direction in the world, from the screen derivatives
  let dpx = dpdx(worldPos)
  let dpy = dpdy(worldPos)
  let dux = dpdx(uv)
  let duy = dpdy(uv)
  let det = duy.y * dux.x - dux.y * duy.x
  let along = (dpy * dux.x - dpx * duy.x) / (det + sign(det) * 0.000001 + 0.0000001)
  let fwd = normalize(along - normal * dot(along, normal) + vec3(0.00001, 0.0, 0.0))
  let n = normalize(normal - fwd * slope * 0.55)
  output color = vec4(litPbr(col * vertexColor.rgb, n), 1.0)
}
