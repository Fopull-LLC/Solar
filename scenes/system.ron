            name: "Post Processing",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: PostProcess(
                enabled: true,
                bloom: true,
                bloom_threshold: 0.3,
                bloom_intensity: 0.3,
                vignette: true,
                vignette_strength: 0.4,
                vignette_radius: 0.5,
                // Screen-space, not Sdf: Sdf AO is the truer one but only SDF
                // matter OCCLUDES in it, so every mesh in this game — the
                // facilities, the ship, the crew — would cast no contact
                // darkening at all and would sit on the ground like a decal.
                // The whole scene is meshes standing on terrain, so the cheap
                // pass is also the right one here.
                ao: ScreenSpace,
                ao_strength: 0.85,
                ao_radius: 0.7,
                posterize_bands: 0,
                posterize_dither: false,
            ),
            scripts: [],
        ),
        (
            name: "Astronaut",
            transform: (
                translation: (28.0, 189.8, -4738.7),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Empty,
            scripts: [
                (
                    kind: "planet_walker",
                    enabled: true,
                    // Only the two that are REAL overrides. The other five just
                    // repeated the script's defaults, which is how a params list
                    // quietly becomes a second, stale copy of the tuning.
                    params: [
                        ("jump", 10.4),
                        ("run", 9.4),
                    ],
                ),
                // NO PARAMS. The list that used to be here pinned the laser to
                // its ORIGINAL tuning — `laser_radius: 0.95`, `laser_rate: 0.3`,
                // `laser_strength: 0.55`, plus a `laser_range` the script had
                // stopped having at all — so every round of tuning done in the
                // script was silently overridden in the only scene that matters.
                //
                // The damage was not just "it felt untuned". At 0.3 s between
                // bites the bore advances 0.54 m, and a 0.95 x 0.55 brush carves
                // a ball of radius 0.52: the balls DID NOT TOUCH. Holding the
                // trigger left a string of separate pockets rather than a
                // tunnel, and a collider full of gaps is what "the digging
                // location alignment is incredibly glitchy and kind of offset"
                // actually looks like from inside the game.
                //
                // Leave this empty. The script's `defaults` are the tuning, they
                // carry the --@range annotations the Inspector needs, and the
                // Inspector will write a params list back here the moment anyone
                // deliberately overrides one.
                (
                    kind: "tool_belt",
                    enabled: true,
                    params: [],
                ),
            ],
