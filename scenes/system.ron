(
    name: "system",
    lighting: (
        direction: (0.4, 0.9, 0.45),
        stars: true,
        color: (0.72, 0.82, 1.0),
        ambient: (0.012, 0.012, 0.018),
        intensity: 1.0,
        shadows: true,
        shadow_softness: 0.35,
        shadow_strength: 1.0,
        shadow_tint: (0.0, 0.0, 0.0),
        shadow_quantize: 0,
        shadow_dither: false,
        shadow_distance: 400.0,
        // FOG. This was 40 → 200, which is a corridor: on a world you can walk
        // around in ten minutes, everything past a couple of hundred metres was
        // a flat grey wall. It was doing real work — it hid the terrain
        // streamer's pop-in (floptle/0067) — but it hid the planet with it, and
        // a body whose horizon you cannot see has no scale.
        //
        // Pushed out to where it reads as distance rather than as a limit, and
        // tinted toward the sky so the far ground meets the horizon instead of
        // ending at it.
        //
        // It also has to BRACKET the rock field. The scattered rock draws to
        // ~190 m (its residency is quadratic in that number — see
        // mineral_field.lua), and in perfectly clear air the edge of the field
        // is a circle you can see. The ramp starts well inside it so the last
        // rocks are already hazing out. Fog is a per-fragment mix and nothing
        // else — it is not a far plane and it culls nothing, so this is a look,
        // not a budget.
        fog_color: (0.52, 0.60, 0.72),
        fog_start: 90.0,
        fog_end: 480.0,
        fog_dither_strength: 0.5,
    ),
    nodes: [
