                (
                    kind: "company",
                    enabled: true,
                    // NO PARAMS. This carried `start_funds: 100000000000` — a
                    // testing balance, and one that contradicts the decision
                    // company.lua documents right above `RICH`: an enormous
                    // grant is the wrong way to test, which is why F9 sets a
                    // ledger FLAG instead. It only ever fired on a slot whose
                    // company happened to boot in the builder rather than in
                    // system.ron, so it read as money appearing at random.
