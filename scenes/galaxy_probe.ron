// GALAXY PROBE — a headless test rig for the galaxy streamer.
//
// The smallest scene that can answer "does space keep going, and does the warp
// ceiling bite before the generator drowns": a System Generator, a Galaxy, an
// anchor the galaxy will stream around, and a script that walks the anchor out
// of the home system at a speed you choose.
//
//     floptle run . --scene galaxy_probe --seconds 90
//
// Nothing in the shipped game references this scene. It is here because the
// real path into the galaxy runs through the save-slot menu, which needs a
// player to press things, and a system that cannot be tested headlessly is a
// system that only gets tested by playing.
(
    nodes: [
        (
            name: "Camera",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Camera(
                fov_y: 1.1519173,
                active: true,
            ),
            scripts: [],
        ),
        // The thing the galaxy streams around. `galaxy` looks for a piloting
        // vessel first and falls back to a node named "Astronaut", so this is
        // the crew's name deliberately — the rig exercises the same lookup the
        // game does rather than a special case written for the test.
        (
            name: "Astronaut",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Empty,
            scripts: [],
        ),
        (
            name: "System Generator",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Empty,
            scripts: [
                (
                    kind: "system_generator",
                    enabled: true,
                    params: [],
                ),
            ],
        ),
        (
            name: "Galaxy",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Empty,
            scripts: [
                (
                    kind: "galaxy",
                    enabled: true,
                    params: [],
                ),
            ],
        ),
        (
            name: "Probe",
            transform: (
                translation: (0.0, 0.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            matter: Empty,
            scripts: [
                (
                    kind: "galaxy_probe",
                    enabled: true,
                    params: [],
                ),
            ],
        ),
    ],
)
