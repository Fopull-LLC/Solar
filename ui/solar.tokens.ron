// SOLAR'S DESIGN TOKENS — the project's colour, spacing, radius and type
// scales. Anywhere a style takes a colour or a number, the token NAME can be
// written instead (`fill: "panel"`), so changing the game's accent is one edit
// here rather than forty in the scene.
//
// The palette: deep space navy behind glass, neutral hairlines, ONE cold
// teal accent for whatever is on, selected or next, and warm colours reserved
// for state — never for decoration. Amber and red MEAN something here, which
// is why money is not amber.
//
// Scale discipline: five spacing steps, four type steps (plus two for numbers
// in the mono face), four radii. Deviating
// from a scale on purpose is what makes a screen look designed; having no scale
// is what makes one look generated. Resist adding more steps.
(
    colors: {
        // Surfaces
        "space":  (0.010, 0.025, 0.040, 0.94),
        "panel":  (0.035, 0.065, 0.095, 0.88),
        "sunken": (0.005, 0.020, 0.030, 0.55),
        // The flight instruments' plate. Nearly opaque on purpose: at 0.72 the
        // orange sky of a desert world came through every panel and turned
        // them brown.
        "glass":  (0.016, 0.024, 0.036, 0.92),
        // Hairlines: a panel's edge, and the quieter edge of a row inside it.
        // Neutral, not teal — a teal outline on every box spent the accent on
        // decoration and left nothing to mark what is actually active.
        "edge":   (0.62, 0.74, 0.84, 0.22),
        "rule":   (0.62, 0.74, 0.84, 0.12),

        // Type
        "ink":    (0.82, 0.91, 0.98, 1.00),
        "muted":  (0.46, 0.60, 0.70, 1.00),
        // Body copy: quieter than ink, far easier to read than muted.
        "soft":   (0.70, 0.80, 0.89, 1.00),

        // THE accent: what is on, selected or next. The one hue that is not
        // state.
        "accent": (0.28, 0.86, 0.74, 1.00),
        // Instrument blue: open contract goals. Kept off frames and edges.
        "signal": (0.42, 0.72, 1.00, 1.00),

        // State, and state only.
        "done":   (0.36, 0.88, 0.52, 1.00),
        "warn":   (1.00, 0.72, 0.32, 1.00),
        "danger": (1.00, 0.42, 0.36, 1.00),

        // The testing account. Deliberately a colour nothing else in the game
        // uses, so a cheated screenshot is obviously a cheated screenshot.
        "debug":  (1.00, 0.36, 0.66, 1.00),
    },
    spacing: { "xs": 4.0, "sm": 8.0, "md": 14.0, "lg": 22.0, "xl": 34.0 },
    radii:   { "sm": 4.0, "md": 9.0, "lg": 16.0, "pill": 999.0 },
    // `readout` and `display` are for numbers only, set in the mono face: the
    // value you fly by, and the one big number on an instrument.
    text:    { "micro": 11.0, "caption": 13.0, "body": 15.0, "title": 19.0,
               "readout": 20.0, "display": 26.0 },
    fonts:   { "mono": "fonts/NotoSansMono-Medium.ttf" },
)
