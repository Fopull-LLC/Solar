// Dust motes hanging in a cave's air, drifting (scripts/underground.lua fires
// them ahead of the eye). Lit only by lamps: in the dark they are not there.
(
    name: "CaveMotes",
    lifetime: 6.0,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Motes",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Alpha,
            lit: true,
            lamp_response: 1.2,
            space: Local,
            clips: [(start: 0.0, end: 6.0, lifetime_jitter: 0.4, emit: Some(Burst(count: 14, count_jitter: 0.3, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (3.2, 2.2, 3.2)),
            velocity: Range(Vec3((-0.04, -0.03, -0.04)), Vec3((0.04, 0.03, 0.04))),
            size: Range(F32(0.012), F32(0.026)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: CurveRange((keys: [(t: 0.0, v: Rgba((0.9, 0.86, 0.8, 0.0)), interp: Linear), (t: 0.2, v: Rgba((0.9, 0.86, 0.8, 0.85)), interp: Linear), (t: 0.8, v: Rgba((0.9, 0.86, 0.8, 0.85)), interp: Linear), (t: 1.0, v: Rgba((0.9, 0.86, 0.8, 0.0)), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: Rgba((0.738, 0.7052, 0.656, 0.0)), interp: Linear), (t: 0.2, v: Rgba((0.738, 0.7052, 0.656, 0.85)), interp: Linear), (t: 0.8, v: Rgba((0.738, 0.7052, 0.656, 0.85)), interp: Linear), (t: 1.0, v: Rgba((0.738, 0.7052, 0.656, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            forces: [Turbulence(frequency: 0.35, strength: 0.05)],
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
