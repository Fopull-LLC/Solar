// A patch of a dust storm (weather.lua): billowing sheets and grit carried on
// the wind (the patch's velocity). Unlit: the script tints each patch with the
// world's ground colour times the day's light.
(
    name: "DustPatch",
    lifetime: 4.5,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Sheets",
            render: Billboard(texture: Some("textures/vfx/smoke/billow_a.png")),
            blend: Alpha,
            soft: 2.0,
            space: World,
            clips: [(start: 0.0, end: 4.2, lifetime_jitter: 0.25, emit: Some(Burst(count: 7, count_jitter: 0.4, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (30.0, 5.0, 30.0)),
            velocity: Range(Vec3((-0.5, -0.3, -0.5)), Vec3((0.5, 0.5, 0.5))),
            size: CurveRange((keys: [(t: 0.0, v: F32(6.0), interp: Linear), (t: 1.0, v: F32(11.0), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: F32(3.9), interp: Linear), (t: 1.0, v: F32(7.15), interp: Linear)], extrapolate: Clamp)),
            rotation: Range(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 0.0, 6.283))),
            angular_velocity: Range(Vec3((0.0, 0.0, -0.15)), Vec3((0.0, 0.0, 0.15))),
            color: CurveRange((keys: [(t: 0.0, v: Rgba((0.95, 0.9, 0.82, 0.0)), interp: Linear), (t: 0.25, v: Rgba((0.95, 0.9, 0.82, 0.16)), interp: Linear), (t: 0.7, v: Rgba((0.95, 0.9, 0.82, 0.13)), interp: Linear), (t: 1.0, v: Rgba((0.95, 0.9, 0.82, 0.0)), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: Rgba((0.779, 0.738, 0.6724, 0.0)), interp: Linear), (t: 0.25, v: Rgba((0.779, 0.738, 0.6724, 0.16)), interp: Linear), (t: 0.7, v: Rgba((0.779, 0.738, 0.6724, 0.13)), interp: Linear), (t: 1.0, v: Rgba((0.779, 0.738, 0.6724, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            inherit_velocity: 1.0,
        ),
        (
            name: "Grit",
            render: Billboard(texture: Some("textures/vfx/debris/grit.png")),
            blend: Alpha,
            orient: Velocity,
            stretch: 1.5,
            speed_stretch: 0.25,
            space: World,
            clips: [(start: 0.0, end: 1.6, lifetime_jitter: 0.2, emit: Some(Burst(count: 60, count_jitter: 0.2, pulses: 3, interval: 0.1, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (20.0, 3.0, 20.0)),
            velocity: Range(Vec3((-0.6, -0.8, -0.6)), Vec3((0.6, 0.4, 0.6))),
            size: Range(F32(0.03), F32(0.05)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.85, 0.78, 0.66, 0.0)), interp: Linear), (t: 0.1, v: Rgba((0.85, 0.78, 0.66, 0.8)), interp: Linear), (t: 1.0, v: Rgba((0.85, 0.78, 0.66, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            inherit_velocity: 1.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
