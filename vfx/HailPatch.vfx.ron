// A patch of hail (weather.lua): ice stones falling at 15-20 m/s, a few of which
// hit the ground and bounce (particle collision).
(
    name: "HailPatch",
    lifetime: 2.0,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Stones",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Alpha,
            orient: Velocity,
            stretch: 1.2,
            speed_stretch: 0.07,
            space: World,
            clips: [(start: 0.0, end: 1.4, lifetime_jitter: 0.1, emit: Some(Burst(count: 40, count_jitter: 0.2, pulses: 3, interval: 0.05, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (14.0, 8.0, 14.0)),
            velocity: Range(Vec3((0.0, -20.0, 0.0)), Vec3((0.0, -15.0, 0.0))),
            size: Range(F32(0.06), F32(0.1)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.9, 0.93, 0.96, 0.0)), interp: Linear), (t: 0.05, v: Rgba((0.9, 0.93, 0.96, 0.85)), interp: Linear), (t: 0.9, v: Rgba((0.9, 0.93, 0.96, 0.85)), interp: Linear), (t: 1.0, v: Rgba((0.9, 0.93, 0.96, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            inherit_velocity: 1.0,
        ),
        (
            name: "Bouncers",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Alpha,
            space: World,
            clips: [(start: 0.0, end: 1.8, lifetime_jitter: 0.2, emit: Some(Burst(count: 3, count_jitter: 0.2, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (8.0, 3.0, 8.0)),
            velocity: Range(Vec3((-0.5, -15.0, -0.5)), Vec3((0.5, -11.0, 0.5))),
            size: CurveRange((keys: [(t: 0.0, v: F32(0.08), interp: Linear), (t: 0.75, v: F32(0.08), interp: Linear), (t: 1.0, v: F32(0.0), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: F32(0.12), interp: Linear), (t: 0.75, v: F32(0.12), interp: Linear), (t: 1.0, v: F32(0.0), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((0.95, 0.97, 1.0, 1.0))),
            gravity: 1.0,
            drag: 0.0,
            inherit_velocity: 0.6,
            collide: Some((bounce: 0.5, friction: 0.3, die: false)),
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
