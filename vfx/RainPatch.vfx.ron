// A patch of rain, fired a few metres over the camera by weather.lua several
// times a second (with the wind as its velocity): lit streaks falling at
// terminal velocity and a faint veil.
(
    name: "RainPatch",
    lifetime: 2.4,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Drops",
            render: Billboard(texture: Some("textures/vfx/water/droplet.png")),
            blend: Alpha,
            orient: Velocity,
            stretch: 3.5,
            speed_stretch: 0.75,
            space: World,
            clips: [(start: 0.0, end: 2.0, lifetime_jitter: 0.12, emit: Some(Burst(count: 120, count_jitter: 0.2, pulses: 4, interval: 0.03, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (14.0, 10.0, 14.0)),
            velocity: Range(Vec3((0.0, -9.5, 0.0)), Vec3((0.0, -6.5, 0.0))),
            size: Range(F32(0.03), F32(0.05)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.82, 0.86, 0.92, 0.0)), interp: Linear), (t: 0.06, v: Rgba((0.82, 0.86, 0.92, 0.75)), interp: Linear), (t: 0.85, v: Rgba((0.82, 0.86, 0.92, 0.75)), interp: Linear), (t: 1.0, v: Rgba((0.82, 0.86, 0.92, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 1.2,
            drag: 0.0,
            inherit_velocity: 1.0,
            forces: [Wind(coupling: 1.0)],
        ),
        (
            name: "Veil",
            render: Billboard(texture: Some("textures/vfx/smoke/soft.png")),
            blend: Alpha,
            lit: true,
            translucency: 0.6,
            soft: 1.5,
            space: World,
            clips: [(start: 0.0, end: 2.4, lifetime_jitter: 0.2, emit: Some(Burst(count: 2, count_jitter: 0.5, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (30.0, 4.0, 30.0)),
            velocity: Range(Vec3((0.0, -3.5, 0.0)), Vec3((0.0, -2.5, 0.0))),
            size: Range(F32(5.0), F32(9.0)),
            rotation: Range(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 0.0, 6.283))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: CurveRange((keys: [(t: 0.0, v: Rgba((0.55, 0.58, 0.62, 0.0)), interp: Linear), (t: 0.3, v: Rgba((0.55, 0.58, 0.62, 0.07)), interp: Linear), (t: 1.0, v: Rgba((0.55, 0.58, 0.62, 0.0)), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: Rgba((0.451, 0.4756, 0.5084, 0.0)), interp: Linear), (t: 0.3, v: Rgba((0.451, 0.4756, 0.5084, 0.07)), interp: Linear), (t: 1.0, v: Rgba((0.451, 0.4756, 0.5084, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.4,
            drag: 0.0,
            inherit_velocity: 1.0,
            forces: [Wind(coupling: 1.0)],
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
