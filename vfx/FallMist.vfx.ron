// The foot of a waterfall (scripts/climate.lua, each fall within reach of the
// eye, fired again every few seconds through vfx.emit so it rides the planet):
// spray thrown up where the sheet lands, and a slow mist drifting off it.
(
    name: "FallMist",
    lifetime: 6.0,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Spray",
            render: Billboard(texture: Some("textures/vfx/water/droplet.png")),
            blend: Alpha,
            orient: Velocity,
            stretch: 1.4,
            speed_stretch: 0.04,
            space: World,
            clips: [(start: 0.0, end: 6.0, lifetime_jitter: 0.4, emit: Some(Rate(rate: 40.0)))],
            automation: [],
            shape: Cone(angle: 55.0, radius: 0.8),
            velocity: Range(Vec3((0.0, 1.5, 0.0)), Vec3((0.0, 4.5, 0.0))),
            size: Range(F32(0.05), F32(0.12)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.92, 0.96, 1.0, 0.85)), interp: Linear), (t: 0.7, v: Rgba((0.9, 0.95, 1.0, 0.6)), interp: Linear), (t: 1.0, v: Rgba((0.9, 0.95, 1.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 1.0,
            drag: 0.2,
            inherit_velocity: 1.0,
        ),
        (
            name: "Mist",
            render: Billboard(texture: Some("textures/vfx/smoke/soft.png")),
            blend: Alpha,
            lit: true,
            translucency: 0.7,
            soft: 0.8,
            space: World,
            clips: [(start: 0.0, end: 6.0, lifetime_jitter: 0.3, emit: Some(Rate(rate: 3.0)))],
            automation: [],
            shape: Sphere(radius: 1.2, shell: false),
            velocity: Range(Vec3((-0.4, 0.3, -0.4)), Vec3((0.4, 1.2, 0.4))),
            size: CurveRange((keys: [(t: 0.0, v: F32(1.2), interp: Linear), (t: 1.0, v: F32(5.0), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: F32(0.8), interp: Linear), (t: 1.0, v: F32(3.4), interp: Linear)], extrapolate: Clamp)),
            rotation: Range(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 0.0, 6.283))),
            angular_velocity: Range(Vec3((0.0, 0.0, -0.1)), Vec3((0.0, 0.0, 0.1))),
            color: CurveRange((keys: [(t: 0.0, v: Rgba((0.9, 0.94, 1.0, 0.0)), interp: Linear), (t: 0.15, v: Rgba((0.9, 0.94, 1.0, 0.28)), interp: Linear), (t: 1.0, v: Rgba((0.9, 0.94, 1.0, 0.0)), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: Rgba((0.74, 0.78, 0.84, 0.0)), interp: Linear), (t: 0.15, v: Rgba((0.74, 0.78, 0.84, 0.28)), interp: Linear), (t: 1.0, v: Rgba((0.74, 0.78, 0.84, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: -0.01,
            drag: 0.3,
            inherit_velocity: 1.0,
            forces: [Wind(coupling: 1.0)],
        ),
    ],
    seed: 3,
    gravity_mode: Field,
)
