// The cloud base lit from inside where a lightning bolt leaves it (weather.lua
// fires it at the top of the bolt, in step with Lightning).
(
    name: "LightningGlow",
    lifetime: 0.45,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Cloud",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            soft: 4.0,
            space: Local,
            clips: [(start: 0.0, end: 0.45, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(26.0), interp: Linear), (t: 1.0, v: F32(30.0), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.0, 1.05, 1.3, 0.55)), interp: Linear), (t: 0.08, v: Rgba((0.25, 0.2625, 0.325, 0.1375)), interp: Linear), (t: 0.16, v: Rgba((1.0, 1.05, 1.3, 0.55)), interp: Linear), (t: 0.24, v: Rgba((0.35, 0.3675, 0.455, 0.1925)), interp: Linear), (t: 0.3, v: Rgba((0.8, 0.84, 1.04, 0.44)), interp: Linear), (t: 0.55, v: Rgba((0.15, 0.1575, 0.195, 0.0825)), interp: Linear), (t: 1.0, v: Rgba((0.0, 0.0, 0.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
