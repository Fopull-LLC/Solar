            angular_velocity: Range(Vec3((0.0, 0.0, -2.0)), Vec3((0.0, 0.0, 2.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.92, 0.94, 0.98, 0.0)), interp: Linear), (t: 0.06, v: Rgba((0.92, 0.94, 0.98, 0.95)), interp: Linear), (t: 0.88, v: Rgba((0.92, 0.94, 0.98, 0.95)), interp: Linear), (t: 1.0, v: Rgba((0.92, 0.94, 0.98, 0.0)), interp: Linear)], extrapolate: Clamp)),
