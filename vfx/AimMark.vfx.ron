// The terrain laser's aim mark: a thin ring laid flat on the ground at the bite
// (the node is stood up on the surface normal), a faint wash under it. The tool
// belt sizes it with the node's scale and colours it with setTint.
(
    name: "AimMark",
    lifetime: 0.6,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Ring",
            render: Billboard(texture: Some("textures/vfx/ring/mark.png")),
            blend: Additive,
            orient: Horizontal,
            soft: 0.02,
            space: Local,
            clips: [(start: 0.0, end: 0.6, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(1.0), interp: Linear), (t: 0.5, v: F32(1.03), interp: Linear), (t: 1.0, v: F32(1.0), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.0, 1.0, 1.0, 0.85)), interp: Linear), (t: 0.5, v: Rgba((1.0, 1.0, 1.0, 1.0)), interp: Linear), (t: 1.0, v: Rgba((1.0, 1.0, 1.0, 0.85)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Wash",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            orient: Horizontal,
            soft: 0.1,
            space: Local,
            clips: [(start: 0.0, end: 0.6, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Const(F32(1.3)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((1.0, 1.0, 1.0, 0.12))),
            gravity: 0.0,
            drag: 0.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
