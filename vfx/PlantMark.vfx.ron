// The plant the tool is locked onto: motes rising through its whole body (the
// node is scaled to the plant: its spread across, its height up; the ring at its
// foot is the AimMark node). The tool belt colours it with setTint.
(
    name: "PlantMark",
    lifetime: 1.6,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Motes",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Additive,
            space: Local,
            clips: [(start: 0.0, end: 1.6, lifetime_jitter: 0.3, emit: Some(Rate(rate: 14.0)))],
            automation: [],
            shape: Cone(angle: 12.0, radius: 0.5),
            velocity: Range(Vec3((0.0, 0.45, 0.0)), Vec3((0.0, 0.75, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.0), interp: Linear), (t: 0.1, v: F32(0.028), interp: Linear), (t: 0.8, v: F32(0.024), interp: Linear), (t: 1.0, v: F32(0.0), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.0, 1.0, 1.0, 0.9)), interp: Linear), (t: 1.0, v: Rgba((1.0, 1.0, 1.0, 0.5)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            forces: [Turbulence(frequency: 2.0, strength: 0.12)],
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
