// The Terrain Laser's dig beam, as a real cutting beam reads: nearly invisible in
// clear air (a hair of warm light, a faint scatter off the dust it crosses) with
// heat shimmer along it. tool_belt aims it with setBeamEnd and plays it only in
// air, scaled by the air and the power; in vacuum nothing of the beam shows.
(
    name: "MiningBeam",
    lifetime: 0.3,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Core",
            render: Beam(texture: Some("textures/vfx/beam/core.png")),
            blend: Additive,
            segments: 24,
            beam_end: (0.0, 0.0, -10.0),
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.009), interp: Linear), (t: 0.33, v: F32(0.011), interp: Linear), (t: 0.66, v: F32(0.008), interp: Linear), (t: 1.0, v: F32(0.009), interp: Linear)], extrapolate: Repeat)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((1.5, 1.3, 1.05, 0.22))),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Scatter",
            render: Beam(texture: Some("textures/vfx/beam/glow.png")),
            blend: Additive,
            segments: 24,
            beam_end: (0.0, 0.0, -10.0),
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.06), interp: Linear), (t: 0.5, v: F32(0.07), interp: Linear), (t: 1.0, v: F32(0.06), interp: Linear)], extrapolate: Repeat)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((0.9, 0.52, 0.26, 0.06))),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Shimmer",
            render: Beam(texture: Some("textures/vfx/distort/haze.png")),
            blend: Distortion,
            segments: 20,
            beam_end: (0.0, 0.0, -10.0),
            scroll: 5.0,
            distortion: 0.005,
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Const(F32(0.14)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((1.0, 1.0, 1.0, 0.8))),
            gravity: 0.0,
            drag: 0.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
