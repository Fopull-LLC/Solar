// The gravity gun letting go: the shell pops, a few sparks drift off.
(
    name: "GravFizzle",
    lifetime: 0.4,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Pop",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            soft: 0.2,
            space: Local,
            clips: [(start: 0.0, end: 0.25, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.5), interp: Linear), (t: 1.0, v: F32(0.9), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.8, 1.4, 2.4, 0.5)), interp: Linear), (t: 1.0, v: Rgba((0.6, 1.0, 2.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Sparks",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Additive,
            orient: Velocity,
            speed_stretch: 0.06,
            space: World,
            clips: [(start: 0.0, end: 0.4, lifetime_jitter: 0.4, emit: Some(Burst(count: 8, count_jitter: 0.2, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Sphere(radius: 0.1, shell: true),
            velocity: Range(Vec3((0.0, 0.8, 0.0)), Vec3((0.0, 2.4, 0.0))),
            size: Const(F32(0.03)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.6, 2.4, 3.2, 1.0)), interp: Linear), (t: 1.0, v: Rgba((0.8, 1.4, 2.4, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.8,
            drag: 1.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
