// Blizzard snow (weather.lua): flakes driven sideways by the gale and drawn
// along their motion, fired beside SnowPatch once a cold storm is up.
(
    name: "SnowDrift",
    lifetime: 2.4,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Driven",
            render: Billboard(texture: Some("textures/vfx/glow/tight.png")),
            blend: Alpha,
            orient: Velocity,
            stretch: 1.0,
            speed_stretch: 0.35,
            space: World,
            clips: [(start: 0.0, end: 2.2, lifetime_jitter: 0.2, emit: Some(Burst(count: 30, count_jitter: 0.2, pulses: 3, interval: 0.1, interval_jitter: 0.2)))],
            automation: [],
            shape: Box(size: (14.0, 5.0, 14.0)),
            velocity: Range(Vec3((-0.5, -1.5, -0.5)), Vec3((0.5, -0.6, 0.5))),
            size: Range(F32(0.06), F32(0.11)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((0.92, 0.94, 0.98, 0.0)), interp: Linear), (t: 0.1, v: Rgba((0.92, 0.94, 0.98, 0.85)), interp: Linear), (t: 0.85, v: Rgba((0.92, 0.94, 0.98, 0.85)), interp: Linear), (t: 1.0, v: Rgba((0.92, 0.94, 0.98, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
            inherit_velocity: 1.0,
            forces: [Turbulence(frequency: 0.8, strength: 2.0)],
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
