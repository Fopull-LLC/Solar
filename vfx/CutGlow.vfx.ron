// The laser's cut glowing where it has bitten (vfx.laserHit, a few a second):
// spots round the bite, orange cooling to dull red and dark over six seconds,
// left behind on the rock as the bore eats on.
(
    name: "CutGlow",
    lifetime: 6.0,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Edge",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            soft: 0.05,
            space: World,
            clips: [(start: 0.0, end: 6.0, lifetime_jitter: 0.3, emit: Some(Burst(count: 3, count_jitter: 0.3, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Ring(radius: 0.32),
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Range(F32(0.14), F32(0.26)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((2.6, 1.15, 0.3, 0.9)), interp: Linear), (t: 0.12, v: Rgba((2.0, 0.7, 0.14, 0.8)), interp: Linear), (t: 0.35, v: Rgba((1.1, 0.25, 0.05, 0.65)), interp: Linear), (t: 0.7, v: Rgba((0.4, 0.06, 0.01, 0.4)), interp: Linear), (t: 1.0, v: Rgba((0.15, 0.02, 0.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
