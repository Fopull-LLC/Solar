            clips: [(start: 0.0, end: 4.0, lifetime_jitter: 0.3, emit: Some(Burst(count: 2, count_jitter: 0.5, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Ring(radius: 0.22),
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Range(F32(0.03), F32(0.06)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((3.0, 1.6, 0.5, 1.0)), interp: Linear), (t: 0.3, v: Rgba((2.0, 0.6, 0.1, 0.9)), interp: Linear), (t: 0.7, v: Rgba((0.8, 0.12, 0.02, 0.6)), interp: Linear), (t: 1.0, v: Rgba((0.3, 0.03, 0.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
