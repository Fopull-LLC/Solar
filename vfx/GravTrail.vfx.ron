// A thrown object's wake: motes that keep the throw's velocity and arc down
// with it, each trailing a short streak.
(
    name: "GravTrail",
    lifetime: 0.7,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Streak",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Additive,
            trail: Some((time: 0.25, width: 0.05, fade: true, texture: Some("textures/vfx/spark/streak.png"), min_distance: 0.03, emitter_path: false)),
            space: World,
            clips: [(start: 0.0, end: 0.7, lifetime_jitter: 0.4, emit: Some(Burst(count: 9, count_jitter: 0.2, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Sphere(radius: 0.25, shell: false),
            velocity: Range(Vec3((-0.6, -0.6, -0.6)), Vec3((0.6, 0.6, 0.6))),
            size: Curve((keys: [(t: 0.0, v: F32(0.05), interp: Linear), (t: 1.0, v: F32(0.0), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.6, 2.4, 3.2, 1.0)), interp: Linear), (t: 1.0, v: Rgba((0.8, 1.4, 2.4, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 1.0,
            drag: 0.4,
            inherit_velocity: 1.0,
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
