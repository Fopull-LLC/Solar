// Turbojet exhaust: the glowing tailpipe, a short pale-orange core and the hot
// gas thinning behind it. On prefabs/FxJet's "Jet Plume" node (local +Y = out of
// the nozzle); vehicle_fx.lua drives setIntensity by the spool.
(
    name: "JetPlume",
    lifetime: 0.5,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Pipe",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            soft: 0.15,
            space: Local,
            clips: [(start: 0.0, end: 0.5, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.95), interp: Linear), (t: 0.5, v: F32(1.05), interp: Linear), (t: 1.0, v: F32(0.95), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.5, 0.55, 0.18, 0.42)), interp: Linear), (t: 0.5, v: Rgba((1.6, 0.6, 0.2, 0.5)), interp: Linear), (t: 1.0, v: Rgba((1.5, 0.55, 0.18, 0.42)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
