            clips: [(start: 0.0, end: 0.13, lifetime_jitter: 0.2, emit: Some(Rate(rate: 70.0))), (start: 0.13, end: 0.26, lifetime_jitter: 0.2, emit: Some(Rate(rate: 70.0))), (start: 0.26, end: 0.39, lifetime_jitter: 0.2, emit: Some(Rate(rate: 70.0))), (start: 0.39, end: 0.52, lifetime_jitter: 0.2, emit: Some(Rate(rate: 70.0)))],
            automation: [],
            shape: Cone(angle: 2.5, radius: 0.12),
            velocity: Range(Vec3((0.0, 42.0, 0.0)), Vec3((0.0, 52.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.55), interp: Linear), (t: 0.5, v: F32(0.75), interp: Linear), (t: 1.0, v: F32(0.9), interp: Linear)], extrapolate: Clamp)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.8, 0.85, 0.35, 0.34)), interp: Linear), (t: 0.4, v: Rgba((1.4, 0.5, 0.16, 0.18)), interp: Linear), (t: 1.0, v: Rgba((0.8, 0.25, 0.06, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Gas",
            render: Billboard(texture: Some("textures/vfx/glow/soft.png")),
            blend: Additive,
            soft: 0.3,
            space: Local,
            clips: [(start: 0.0, end: 0.28, lifetime_jitter: 0.2, emit: Some(Rate(rate: 46.0))), (start: 0.28, end: 0.56, lifetime_jitter: 0.2, emit: Some(Rate(rate: 46.0)))],
