// An engine cutting off: the last propellant flashing to vapour out of the bell (+Y = out of the nozzle).
(
    name: "ShutdownPuff",
    lifetime: 2.0,
    playback: OneShot,
    end: Destroy,
    tracks: [
        (
            name: "Vapour",
            render: Billboard(texture: Some("textures/vfx/smoke/soft.png")),
            blend: Alpha,
            lit: true,
            translucency: 0.6,
            soft: 0.6,
            space: Local,
            clips: [(start: 0.0, end: 2.0, lifetime_jitter: 0.3, emit: Some(Burst(count: 5, count_jitter: 0.2, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
            shape: Cone(angle: 20.0, radius: 0.25),
            velocity: Range(Vec3((0.0, 1.5, 0.0)), Vec3((0.0, 4.0, 0.0))),
            size: CurveRange((keys: [(t: 0.0, v: F32(0.5), interp: Linear), (t: 1.0, v: F32(2.2), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: F32(0.325), interp: Linear), (t: 1.0, v: F32(1.43), interp: Linear)], extrapolate: Clamp)),
            rotation: Range(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 0.0, 6.283))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: CurveRange((keys: [(t: 0.0, v: Rgba((0.85, 0.86, 0.88, 0.0)), interp: Linear), (t: 0.08, v: Rgba((0.85, 0.86, 0.88, 0.32)), interp: Linear), (t: 1.0, v: Rgba((0.85, 0.86, 0.88, 0.0)), interp: Linear)], extrapolate: Clamp), (keys: [(t: 0.0, v: Rgba((0.697, 0.7052, 0.7216, 0.0)), interp: Linear), (t: 0.08, v: Rgba((0.697, 0.7052, 0.7216, 0.32)), interp: Linear), (t: 1.0, v: Rgba((0.697, 0.7052, 0.7216, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 0.6,
            forces: [Wind(coupling: 1.6)],
        ),
    ],
    seed: 1,
    gravity_mode: Field,
)
