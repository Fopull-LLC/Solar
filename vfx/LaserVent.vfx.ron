// The terrain laser shedding heat (scripts/tool_belt.lua, THE ENERGY): a
// shimmer of hot air rising off the heat sink and the odd ember, as strong as
// the laser is hot (setIntensity). Rides the sink's top, its +Y the local up;
// the particles stay where they were born, so the haze trails as the crew
// turns. A handful of particles: cheap enough to run every frame.
(
    name: "LaserVent",
    lifetime: 1.2,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Haze",
            render: Billboard(texture: Some("textures/vfx/distort/haze.png")),
            blend: Distortion,
            distortion: 0.010,
            soft: 0.05,
            space: World,
            clips: [(start: 0.0, end: 0.6, lifetime_jitter: 0.3, emit: Some(Rate(rate: 9.0))), (start: 0.6, end: 1.2, lifetime_jitter: 0.3, emit: Some(Rate(rate: 9.0)))],
            automation: [],
            shape: Sphere(radius: 0.03, shell: false),
            velocity: Range(Vec3((-0.04, 0.22, -0.04)), Vec3((0.04, 0.42, 0.04))),
            size: Curve((keys: [(t: 0.0, v: F32(0.06), interp: Linear), (t: 1.0, v: F32(0.20), interp: Linear)], extrapolate: Clamp)),
            rotation: Range(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 0.0, 360.0))),
            angular_velocity: Range(Vec3((0.0, 0.0, -40.0)), Vec3((0.0, 0.0, 40.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.0, 1.0, 1.0, 0.0)), interp: Linear), (t: 0.25, v: Rgba((1.0, 1.0, 1.0, 0.8)), interp: Linear), (t: 1.0, v: Rgba((1.0, 1.0, 1.0, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 1.0,
        ),
        (
            name: "Embers",
            render: Billboard(texture: Some("textures/vfx/spark/dot.png")),
            blend: Additive,
            orient: Velocity,
            speed_stretch: 0.03,
            space: World,
            clips: [(start: 0.0, end: 0.6, lifetime_jitter: 0.5, emit: Some(Rate(rate: 3.0))), (start: 0.6, end: 1.2, lifetime_jitter: 0.5, emit: Some(Rate(rate: 3.0)))],
            automation: [],
            shape: Sphere(radius: 0.025, shell: false),
            velocity: Range(Vec3((-0.08, 0.25, -0.08)), Vec3((0.08, 0.6, 0.08))),
            size: Const(F32(0.008)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((3.0, 1.6, 0.5, 1.0)), interp: Linear), (t: 0.6, v: Rgba((2.0, 0.6, 0.12, 0.8)), interp: Linear), (t: 1.0, v: Rgba((0.8, 0.15, 0.03, 0.0)), interp: Linear)], extrapolate: Clamp)),
            gravity: 0.0,
            drag: 2.0,
        ),
    ],
    seed: 3,
    gravity_mode: Field,
)
