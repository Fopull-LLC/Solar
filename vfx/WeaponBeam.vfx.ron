// A WEAPON LASER's beam (expansion X9; scripts/lasers.lua, laser_turret.lua). A 1.06 µm beam is
// invisible: what you see is the air it lights and ionises along the path and the hot spot at the
// end. A thin blue-white core, a faint violet halo that shimmers, a star at the muzzle. Additive,
// 3 tracks (the mining beam's budget); its END is setBeamEnd, its node a world point (top level).
(
    name: "WeaponBeam",
    lifetime: 0.3,
    playback: Looping,
    end: Destroy,
    tracks: [
        (
            name: "Core",
            render: Beam(texture: Some("textures/vfx/beam/core.png")),
            blend: Additive,
            segments: 24,
            beam_end: (0.0, 0.0, -10.0),
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.07), interp: Linear), (t: 0.5, v: F32(0.09), interp: Linear), (t: 1.0, v: F32(0.07), interp: Linear)], extrapolate: Repeat)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((3.0, 3.4, 4.2, 1.0))),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Halo",
            render: Beam(texture: Some("textures/vfx/beam/glow.png")),
            blend: Additive,
            segments: 24,
            beam_end: (0.0, 0.0, -10.0),
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Curve((keys: [(t: 0.0, v: F32(0.4), interp: Linear), (t: 0.5, v: F32(0.48), interp: Linear), (t: 1.0, v: F32(0.4), interp: Linear)], extrapolate: Repeat)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Curve((keys: [(t: 0.0, v: Rgba((1.1, 1.0, 2.0, 0.32)), interp: Linear), (t: 0.5, v: Rgba((1.3, 1.2, 2.3, 0.42)), interp: Linear), (t: 1.0, v: Rgba((1.1, 1.0, 2.0, 0.32)), interp: Linear)], extrapolate: Repeat)),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "Scroll",
            render: Beam(texture: Some("textures/vfx/beam/shimmer.png")),
            blend: Additive,
            segments: 32,
            beam_end: (0.0, 0.0, -10.0),
            wave_amplitude: 0.01,
            wave_frequency: 9.0,
            scroll: 40.0,
            space: Local,
            clips: [],
            automation: [],
            shape: Point,
            velocity: Const(Vec3((0.0, 0.0, 0.0))),
            size: Const(F32(0.2)),
            rotation: Const(Vec3((0.0, 0.0, 0.0))),
            angular_velocity: Const(Vec3((0.0, 0.0, 0.0))),
            color: Const(Rgba((1.4, 1.5, 2.2, 0.3))),
            gravity: 0.0,
            drag: 0.0,
        ),
        (
            name: "MuzzleStar",
            render: Billboard(texture: Some("textures/vfx/glow/star.png")),
            blend: Additive,
            soft: 0.05,
            space: Local,
            clips: [(start: 0.0, end: 0.3, emit: Some(Burst(count: 1, count_jitter: 0.0, pulses: 1, interval: 0.0, interval_jitter: 0.2)))],
            automation: [],
