            scale: (1.0, 1.0, 1.0),
        ),
        matter: Empty,
        scripts: [
            (
                kind: "catalog_panel",
                enabled: true,
                params: [],
            ),
        ],
        ui: Some((
            place: Pin(
                anchor: TopLeft,
                offset: (0.0, 0.0),
            ),
            size: (Fixed(10.0), Fixed(10.0)),
            visible: true,
            opacity: 1.0,
        )),
    ),
]
