[
    // A bare craft root for a piece of debris built from script (debris_pack.lua):
    // the Vessel's dynamic assembly body, no controller. Its part nodes go under it
    // and one assembly.rebuild makes them a compound.
    (
        name: "DebrisRoot",
        transform: (
            translation: (0.0, 0.0, 0.0),
            rotation: (0.0, 0.0, 0.0, 1.0),
            scale: (1.0, 1.0, 1.0),
        ),
        matter: Empty,
        scripts: [],
        rigidbody: Some((
            mode: Dynamic,
            radius: 0.5,
            height: 2.0,
            half_extents: (0.5, 0.5, 0.5),
            restitution: 0.05,
            friction: 0.7,
            gravity: true,
            lock_pos: (false, false, false),
            lock_rot: (false, false, false),
            assembly: true,
        )),
    ),
]
