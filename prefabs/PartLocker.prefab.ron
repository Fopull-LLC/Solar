// STOWAGE LOCKER — a small stack box with its OWN container (parts_registry
// `store = 80` kg; vessel_controller's lockers, the context menu's "Contents").
// For now it borrows the Cargo Bay's mesh at 0.6 × 0.5 × 0.6 (a 0.6-wide,
// 0.5-tall drum; the collider half-box scales with it). A mesh of its own
// belongs in tools/gen_part_meshes.py.
[
    (
        name: "PartLocker",
        transform: (
            translation: (0.0, 0.0, 0.0),
            rotation: (0.0, 0.0, 0.0, 1.0),
            scale: (0.6, 0.5, 0.6),
        ),
        matter: Mesh(
            asset_path: "models/parts/cargo.glb",
        ),
        object_materials: {
            "Dark": (
                color: (0.3, 0.3, 0.32),
                texture: Some("textures/parts/metal_albedo.png"),
                normal_map: Some("textures/parts/metal_normal.png"),
                normal_strength: 1.0,
                roughness_map: Some("textures/parts/metal_orm.png"),
                roughness: 1.2,
                metallic_map: Some("textures/parts/metal_orm.png"),
                metallic: 0.4,
                ao_map: Some("textures/parts/metal_orm.png"),
                shader: Some("shaders/hullPanels.flsl"),
                shader_params: {
                    "tint": (0.3, 0.3, 0.32, 1.0),
                },
                shading: Physical,
            ),
            "Decal": (
                color: (1.0, 1.0, 1.0),
                texture: Some("textures/parts/markings.png"),
                roughness: 0.55,
                metallic: 0.0,
                shading: Physical,
            ),
            "Metal": (
                color: (1, 1, 1),
                texture: Some("textures/parts/metal_albedo.png"),
                normal_map: Some("textures/parts/metal_normal.png"),
                normal_strength: 1.0,
                roughness_map: Some("textures/parts/metal_orm.png"),
                roughness: 1.0,
                metallic_map: Some("textures/parts/metal_orm.png"),
                metallic: 0.55,
                ao_map: Some("textures/parts/metal_orm.png"),
                shader: Some("shaders/hullPanels.flsl"),
                shader_params: {
                    "tint": (1, 1, 1, 1.0),
                },
                shading: Physical,
            ),
            "Paint": (
                color: (1, 1, 1),
                texture: Some("textures/parts/paint_albedo.png"),
                normal_map: Some("textures/parts/paint_normal.png"),
                normal_strength: 1.0,
                roughness_map: Some("textures/parts/paint_orm.png"),
                roughness: 1.0,
                metallic_map: Some("textures/parts/paint_orm.png"),
