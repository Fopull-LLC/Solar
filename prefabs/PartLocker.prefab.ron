                roughness: 0.6,
                metallic: 0.0,
                shading: Physical,
            ),
        },
        scripts: [],
        rigidbody: Some((
            boxed: true,
            mode: Kinematic,
            radius: 0.5,
            height: 2.0,
            half_extents: (0.5, 0.5, 0.5),
