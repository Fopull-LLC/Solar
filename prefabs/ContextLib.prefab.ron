// CONTEXT LIBRARY — scripts/context_registry.lua (the right-click menus'
// provider registry) and scripts/context_providers.lua (the game's own
// providers) and scripts/targeting.lua. Spawned by context_menu.lua / builder_context.lua when the
// scene carries no node running the registry; reached with
// findScript("context_registry").
[
    (
        name: "ContextLib",
        transform: (
            translation: (0.0, 0.0, 0.0),
            rotation: (0.0, 0.0, 0.0, 1.0),
            scale: (1.0, 1.0, 1.0),
        ),
        matter: Empty,
        scripts: [
            (
                kind: "context_registry",
                enabled: true,
                params: [],
            ),
            (
                kind: "context_providers",
                enabled: true,
                params: [],
            ),
            // the target (Set target / SAS Target / the docking indicator):
            // scripts/targeting.lua, its rows on these menus
            (
                kind: "targeting",
                enabled: true,
                params: [],
            ),
            // every kit piece's identity (title, condition, connections,
            // why) and its designation: scripts/part_info.lua
            (
                kind: "part_info",
                enabled: true,
                params: [],
            ),
            // the consoles: E at a desk monitor, a wall screen, the reactor's
            // desk, a PLC, a ruin's terminal opens its CRT pages
            // (scripts/terminal.lua, the pages in terminal_pages.lua) and the
            // base's event log they read (scripts/base_log.lua)
            (
                kind: "base_log",
                enabled: true,
                params: [],
            ),
            (
                kind: "terminal",
                enabled: true,
                params: [],
            ),
            (
                kind: "terminal_pages",
                enabled: true,
                params: [],
            ),
        ],
    ),
]
